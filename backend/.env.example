# Server
PORT=3000
NODE_ENV=development

# Database: use an owner connection for schema/migration commands and
# workbridge_app for normal runtime.
DATABASE_URL=postgres://workbridge_app:CHANGE_ME@localhost:5432/workbridge
DB_SSL=false

# Authentication secrets (generate independent random values)
JWT_ACCESS_SECRET=CHANGE_THIS_TO_RANDOM_32_BYTE_BASE64_STRING
JWT_REFRESH_SECRET=CHANGE_THIS_TO_DIFFERENT_RANDOM_32_BYTE_BASE64_STRING
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
BCRYPT_ROUNDS=12

# Independent encryption keys. DB_ENCRYPTION_KEY is for pgcrypto;
# FILE_ENCRYPTION_KEY must encode exactly 32 random bytes (base64 or 64 hex chars).
DB_ENCRYPTION_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET
FILE_ENCRYPTION_KEY=CHANGE_THIS_TO_32_BYTE_BASE64_KEY

# CORS allowlist, comma-separated
ALLOWED_ORIGINS=http://localhost:5173

# Optional local HTTPS (provide both paths to PEM files; omitted means local HTTP)
SSL_KEY_PATH=
SSL_CERT_PATH=
